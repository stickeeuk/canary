includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/ekino/phpstan-banned-code/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    level: 5
    paths:
        - src
    banned_code:
        nodes:
            -
                type: Stmt_Echo
                functions: null
            -
                type: Expr_Eval
                functions: null
            -
                type: Expr_Exit
                functions: null
            -
                type: Expr_FuncCall
                functions:
                    - dd
                    - ddd
                    - debug_backtrace
                    - dump
                    - exec
                    - passthru
                    - phpinfo
                    - print_r
                    - proc_open
                    - ray
                    - shell_exec
                    - system
                    - var_dump
            -
                type: Expr_Print
                functions: null
            -
                type: Expr_ShellExec
                functions: null
        use_from_tests: true
        non_ignorable: true
